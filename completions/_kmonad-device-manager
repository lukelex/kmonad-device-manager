#compdef kmonad-device-manager

_kmonad-device-manager() {
  _arguments \
    '(-h --help)'{-h,--help}'[show usage]' \
    '--json[emit machine-readable JSON]' \
    '--doctor[show a dependency status report]' \
    '--version[show version]' \
    '--status[show manager status]' \
    'devices[list known keyboard devices]' \
    'identify[run or inspect keyboard identification]:action:(start status cancel)' \
    'validate[preview a candidate without applying it]:source:(model file)' \
    'apply[transactionally persist and activate a managed configuration]:model file:_files' \
    'config[manage manager-owned configurations]:action:(create update enable disable delete)' \
    '--status=json[show manager status as JSON]' \
    '--completion[print completion for a shell]:shell:(bash zsh fish)' \
    '1:command:(ps devices identify validate apply config)'
}

_kmonad-device-manager "$@"
