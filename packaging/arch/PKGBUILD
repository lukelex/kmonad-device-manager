pkgname=kmonad-device-manager
pkgver=1.2.0
pkgrel=1
pkgdesc='Run one KMonad process for every connected configured keyboard'
arch=('x86_64' 'aarch64')
url='https://github.com/lukelex/kmonad-device-manager'
license=('MIT')
depends=('kmonad')
makedepends=('go')
source=("$pkgname-$pkgver.tar.gz::https://github.com/lukelex/kmonad-device-manager/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$pkgname-$pkgver"
  CGO_ENABLED=0 go build -trimpath -ldflags="-s -w -X main.version=$pkgver" -o kmonad-device-manager ./cmd/kmonad-device-manager
}

package() {
  cd "$pkgname-$pkgver"

  install -Dm755 kmonad-device-manager "$pkgdir/usr/bin/kmonad-device-manager"
  install -Dm644 packaging/arch/kmonad-device-manager.service \
    "$pkgdir/usr/lib/systemd/user/kmonad-device-manager.service"
  install -Dm644 packaging/arch/kmonad-device-manager.sysusers \
    "$pkgdir/usr/lib/sysusers.d/kmonad-device-manager.conf"
  install -Dm644 system/70-kmonad-uinput.rules \
    "$pkgdir/usr/lib/udev/rules.d/70-kmonad-uinput.rules"
  install -Dm644 system/uinput.conf \
    "$pkgdir/usr/lib/modules-load.d/uinput.conf"
  install -Dm644 completions/kmonad-device-manager.bash \
    "$pkgdir/usr/share/bash-completion/completions/kmonad-device-manager"
  install -Dm644 completions/_kmonad-device-manager \
    "$pkgdir/usr/share/zsh/site-functions/_kmonad-device-manager"
  install -Dm644 completions/kmonad-device-manager.fish \
    "$pkgdir/usr/share/fish/vendor_completions.d/kmonad-device-manager.fish"
  install -Dm644 docs/kmonad-device-manager.1 \
    "$pkgdir/usr/share/man/man1/kmonad-device-manager.1"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
