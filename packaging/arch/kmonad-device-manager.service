[Unit]
Description=KMonad device configuration manager
Documentation=https://github.com/lukelex/kmonad-device-manager

[Service]
Type=simple
EnvironmentFile=-%h/.config/kmonad-device-manager/env
ExecStart=/usr/bin/kmonad-device-manager
Restart=on-failure
RestartSec=5
RestartPreventExitStatus=1 2 127
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
