#!/usr/bin/env bash

set -Eeuo pipefail

config_dir="${KMONAD_CONFIG_DIR:-}"
environment_file="${XDG_CONFIG_HOME:-$HOME/.config}/kmonad-device-manager/env"
if [ -z "$config_dir" ] && [ -r "$environment_file" ]; then
  while IFS= read -r line; do
    case "$line" in
      KMONAD_CONFIG_DIR=*)
        config_dir="${line#KMONAD_CONFIG_DIR=}"
        break
        ;;
    esac
  done < "$environment_file"
fi
config_dir="${config_dir:-${XDG_CONFIG_HOME:-$HOME/.config}/kmonad}"
poll_interval="${KMONAD_POLL_INTERVAL:-2}"
kmonad_command="${KMONAD_COMMAND:-kmonad}"
stop_timeout="${KMONAD_STOP_TIMEOUT:-5}"
stable_runtime=30
declare -A config_signatures=()
declare -A device_ids=()
declare -A duplicate_devices=()
declare -A failures=()
declare -A pids=()
declare -A retry_after=()
declare -A started_at=()

doctor_failures=0

case "${KMONAD_DOCTOR_COLOR:-auto}" in
  always) color=1 ;;
  never) color=0 ;;
  auto) [ -t 1 ] && color=1 || color=0 ;;
  *) color=0 ;;
esac

if [ "$color" -eq 1 ]; then
  green='\033[32m'
  red='\033[31m'
  yellow='\033[33m'
  reset='\033[0m'
else
  green=''
  red=''
  yellow=''
  reset=''
fi

doctor_ok() {
  printf '%b[ok]%b %s\n' "$green" "$reset" "$1"
}

doctor_bad() {
  doctor_failures=$((doctor_failures + 1))
  printf '%b[bad]%b %s\n' "$red" "$reset" "$1"
}

doctor_wait() {
  printf '%b[wait]%b %s\n' "$yellow" "$reset" "$1"
}

positive_integer() {
  case "$1" in
    ''|*[!0-9]*) return 1 ;;
    *) [ "$1" -gt 0 ] ;;
  esac
}

validate_settings() {
  if ! positive_integer "$poll_interval"; then
    printf 'kmonad-device-manager: KMONAD_POLL_INTERVAL must be a positive integer.\n' >&2
    return 1
  fi
  if ! positive_integer "$stop_timeout"; then
    printf 'kmonad-device-manager: KMONAD_STOP_TIMEOUT must be a positive integer.\n' >&2
    return 1
  fi
}

doctor() {
  local command config device
  local -a commands=(awk bash cat ps readlink stat)
  local -a configs=()

  printf 'KMonad Device Manager doctor\n'
  printf 'Configuration directory: %s\n' "$config_dir"

  if command -v "$kmonad_command" >/dev/null 2>&1; then
    doctor_ok "KMonad: $(command -v "$kmonad_command")"
  else
    doctor_bad 'KMonad: not found on PATH'
  fi

  for command in "${commands[@]}"; do
    if command -v "$command" >/dev/null 2>&1; then
      doctor_ok "Command: $command"
    else
      doctor_bad "Command: $command is missing"
    fi
  done

  if positive_integer "$poll_interval"; then
    doctor_ok "Poll interval: ${poll_interval}s"
  else
    doctor_bad "Poll interval: '$poll_interval' is invalid"
  fi
  if positive_integer "$stop_timeout"; then
    doctor_ok "Stop timeout: ${stop_timeout}s"
  else
    doctor_bad "Stop timeout: '$stop_timeout' is invalid"
  fi

  if command -v id >/dev/null 2>&1 && id -nG | tr ' ' '\n' | grep -qx input; then
    doctor_ok 'Group membership: input'
  else
    doctor_bad 'Group membership: input is missing'
  fi
  if command -v id >/dev/null 2>&1 && id -nG | tr ' ' '\n' | grep -qx uinput; then
    doctor_ok 'Group membership: uinput'
  else
    doctor_bad 'Group membership: uinput is missing'
  fi

  if [ -d /sys/module/uinput ]; then
    doctor_ok 'Kernel module: uinput is loaded'
  else
    doctor_bad 'Kernel module: uinput is not loaded'
  fi
  if [ -c /dev/uinput ] && [ -r /dev/uinput ] && [ -w /dev/uinput ]; then
    doctor_ok 'Device access: /dev/uinput is readable and writable'
  else
    doctor_bad 'Device access: /dev/uinput is unavailable or inaccessible'
  fi

  if [ -d "$config_dir" ]; then
    doctor_ok 'Configuration directory exists'
  else
    doctor_bad 'Configuration directory does not exist'
  fi

  if [ -d "$config_dir" ]; then
    if ! command -v awk >/dev/null 2>&1; then
      doctor_bad 'Configuration checks require awk'
    else
      shopt -s nullglob
      configs=("$config_dir"/*.kbd)
      if [ "${#configs[@]}" -eq 0 ]; then
        doctor_bad 'Configuration files: no .kbd files found'
      fi
      for config in "${configs[@]}"; do
        device="$(device_file "$config")"
        if [ -z "$device" ]; then
          doctor_bad "Configuration ${config##*/}: no device-file input"
          continue
        fi
        if [ ! -e "$device" ]; then
          doctor_wait "Input ${config##*/}: $device is not connected"
        elif [ ! -c "$device" ]; then
          doctor_bad "Input ${config##*/}: $device is not a character device"
        elif [ ! -r "$device" ]; then
          doctor_bad "Input ${config##*/}: $device is inaccessible"
        else
          doctor_ok "Input ${config##*/}: $device"
        fi
        if command -v "$kmonad_command" >/dev/null 2>&1; then
          if "$kmonad_command" --dry-run "$config" >/dev/null 2>&1; then
            doctor_ok "Configuration ${config##*/}: parses successfully"
          else
            doctor_bad "Configuration ${config##*/}: KMonad validation failed"
          fi
        fi
      done
    fi
  fi

  if command -v systemctl >/dev/null 2>&1; then
    if systemctl --user is-enabled kmonad-device-manager.service >/dev/null 2>&1; then
      doctor_ok 'Service: enabled'
    else
      doctor_bad 'Service: not enabled'
    fi
    if systemctl --user is-active kmonad-device-manager.service >/dev/null 2>&1; then
      doctor_ok 'Service: active'
    else
      doctor_bad 'Service: inactive'
    fi
  else
    doctor_bad 'Service check: systemctl is missing'
  fi

  return "$doctor_failures"
}

print_completion() {
  local completion_dir completion_file program_path project_dir
  if ! program_path="$(readlink -f "${BASH_SOURCE[0]}")"; then
    printf '%s\n' 'kmonad-device-manager: cannot resolve the completion directory without readlink.' >&2
    return 1
  fi
  project_dir="$(dirname "$(dirname "$program_path")")"

  case "$1" in
    bash) completion_file='kmonad-device-manager.bash' ;;
    zsh) completion_file='_kmonad-device-manager' ;;
    fish) completion_file='kmonad-device-manager.fish' ;;
    *)
      printf 'kmonad-device-manager: unsupported completion shell: %s\n' "$1" >&2
      return 2
      ;;
  esac

  completion_dir="$project_dir/completions"
  if [ ! -r "$completion_dir/$completion_file" ]; then
    completion_dir="$project_dir/share/kmonad-device-manager/completions"
  fi
  if [ ! -r "$completion_dir/$completion_file" ]; then
    printf '%s\n' 'kmonad-device-manager: completion definitions are not installed.' >&2
    return 1
  fi
  cat "$completion_dir/$completion_file"
}

config_signature() {
  stat -Lc '%d:%i:%Y:%s' "$1"
}

device_file() {
  awk -F'"' '/^[[:space:]]*input[[:space:]]+\(device-file[[:space:]]+"/ { print $2; exit }' "$1"
}

device_id() {
  stat -Lc '%d:%i' "$1"
}

is_running() {
  local state
  state="$(ps -o stat= -p "$1" 2>/dev/null || true)"
  [[ -n "$state" && "$state" != *Z* ]]
}

clear_state() {
  local config="$1"
  unset "config_signatures[$config]" "device_ids[$config]" "failures[$config]" \
    "retry_after[$config]" "started_at[$config]"
}

stop_config() {
  local config="$1"
  local pid="${pids[$config]:-}"
  local attempt
  [ -n "$pid" ] || return 0

  if is_running "$pid"; then
    printf 'kmonad-device-manager: stopping %s\n' "$(basename "$config")" >&2
    kill "$pid" 2>/dev/null || true
    for ((attempt = 0; attempt < stop_timeout * 10; attempt++)); do
      is_running "$pid" || break
      sleep 0.1
    done
    if is_running "$pid"; then
      printf 'kmonad-device-manager: force-stopping %s\n' "$(basename "$config")" >&2
      kill -KILL "$pid" 2>/dev/null || true
    fi
  fi
  wait "$pid" 2>/dev/null || true
  unset "pids[$config]"
}

schedule_retry() {
  local config="$1"
  local now="$2"
  local count="${failures[$config]:-0}"
  local delay

  count=$((count + 1))
  delay=$((2 ** count))
  [ "$delay" -le 60 ] || delay=60
  failures["$config"]="$count"
  retry_after["$config"]=$((now + delay))
  printf 'kmonad-device-manager: retrying %s in %ss\n' "$(basename "$config")" "$delay" >&2
}

start_config() {
  local config="$1"
  local now="$2"

  if ! "$kmonad_command" --dry-run "$config"; then
    printf 'kmonad-device-manager: invalid configuration %s\n' "$(basename "$config")" >&2
    schedule_retry "$config" "$now"
    return 1
  fi

  printf 'kmonad-device-manager: starting %s\n' "$(basename "$config")" >&2
  "$kmonad_command" "$config" &
  pids["$config"]=$!
  started_at["$config"]="$now"
}

reconcile() {
  local config device identity signature now pid
  local -A active_configs=()
  local -A active_devices=()

  now="$(date +%s)"
  shopt -s nullglob
  for config in "$config_dir"/*.kbd; do
    active_configs["$config"]=1
    device="$(device_file "$config")"

    if [ -z "$device" ] || [ ! -c "$device" ] || [ ! -r "$device" ]; then
      stop_config "$config"
      clear_state "$config"
      continue
    fi

    identity="$(device_id "$device")"
    signature="$(config_signature "$config")"
    if [ -n "${active_devices[$identity]:-}" ]; then
      if [ "${duplicate_devices[$config]:-}" != "$identity" ]; then
        printf 'kmonad-device-manager: skipping %s; it duplicates %s\n' \
          "$(basename "$config")" "$(basename "${active_devices[$identity]}")" >&2
        duplicate_devices["$config"]="$identity"
      fi
      stop_config "$config"
      clear_state "$config"
      continue
    fi
    active_devices["$identity"]="$config"
    unset "duplicate_devices[$config]"

    if [ "${device_ids[$config]:-}" != "$identity" ] \
      || [ "${config_signatures[$config]:-}" != "$signature" ]; then
      stop_config "$config"
      failures["$config"]=0
      retry_after["$config"]=0
      device_ids["$config"]="$identity"
      config_signatures["$config"]="$signature"
    fi

    pid="${pids[$config]:-}"
    if [ -n "$pid" ] && is_running "$pid"; then
      if [ $((now - ${started_at[$config]:-$now})) -ge "$stable_runtime" ]; then
        failures["$config"]=0
        retry_after["$config"]=0
      fi
      continue
    fi

    if [ -n "$pid" ]; then
      stop_config "$config"
      schedule_retry "$config" "$now"
    fi

    if [ "$now" -lt "${retry_after[$config]:-0}" ]; then
      continue
    fi
    start_config "$config" "$now" || true
  done

  for config in "${!pids[@]}"; do
    if [ -z "${active_configs[$config]:-}" ]; then
      stop_config "$config"
      clear_state "$config"
    fi
  done

  for config in "${!duplicate_devices[@]}"; do
    [ -n "${active_configs[$config]:-}" ] || unset "duplicate_devices[$config]"
  done
}

cleanup() {
  local config
  for config in "${!pids[@]}"; do
    stop_config "$config"
  done
}

if [ "${KMONAD_DEVICE_MANAGER_LIBRARY:-0}" = 1 ] && [ "${BASH_SOURCE[0]}" != "$0" ]; then
  return 0
fi

case "${1:-}" in
  --doctor)
    if doctor; then
      exit 0
    else
      exit $?
    fi
    ;;
  --completion)
    if [ "$#" -ne 2 ]; then
      printf '%s\n' 'Usage: kmonad-device-manager --completion <bash|zsh|fish>' >&2
      exit 2
    fi
    print_completion "$2"
    exit $?
    ;;
  -h|--help)
    printf '%s\n' 'Usage: kmonad-device-manager [--doctor] [--completion <bash|zsh|fish>]'
    exit 0
    ;;
  "") ;;
  *)
    printf 'kmonad-device-manager: unknown option: %s\n' "$1" >&2
    exit 2
    ;;
esac

if ! validate_settings; then
  exit 2
fi

if ! command -v "$kmonad_command" >/dev/null 2>&1; then
  printf '%s\n' 'kmonad-device-manager: KMonad is not installed or is not on PATH.' >&2
  printf '%s\n' 'Install KMonad from https://github.com/kmonad/kmonad, then restart this service.' >&2
  exit 127
fi

trap 'cleanup; exit 0' INT TERM

while true; do
  reconcile
  sleep "$poll_interval"
done
